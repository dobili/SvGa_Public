{
  "name": "schach-von-grund-auf",
  "private": true,
  "version": "0.2.137",
  "description": "Companion-App zum Buch „Schach von Grund auf“",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vorbereiten": "node skripte/erzeuge-typen.mjs && node skripte/kopiere-engine.mjs && node skripte/kopiere-trainerdaten.mjs",
    "dev": "npm run vorbereiten && vite",
    "typen": "npm run vorbereiten && tsc --noEmit",
    "stil": "eslint . --max-warnings 0 && prettier --check .",
    "stil:reparieren": "eslint . --fix && prettier --write .",
    "test": "npm run vorbereiten && vitest run",
    "pruefen": "npm run typen && npm run stil && vitest run",
    "build": "npm run vorbereiten && tsc --noEmit && vite build && node skripte/pruefe-groesse.mjs",
    "build:veroeffentlichung": "VEROEFFENTLICHUNG=1 npm run build && node skripte/pruefe-veroeffentlichung.mjs",
    "vorschau": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "messen:stufen": "node skripte/messe-stufen.mjs",
    "messen:opfer": "vitest run --config vitest.messung.config.ts src/spiel/opfer.messung.ts",
    "messen:vergleich": "vitest run --config vitest.messung.config.ts src/spiel/vergleich.messung.ts",
    "messen:eichung": "vitest run --config vitest.messung.config.ts src/spiel/eichung.messung.ts",
    "messen:loesungen": "vitest run --config vitest.messung.config.ts src/training/loesungen.messung.ts",
    "deploy:probe": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "chessops": "0.15.1",
    "idb": "8.0.4",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "19.0.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "wrangler": "4.150.0"
  }
}
