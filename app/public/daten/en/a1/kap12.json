    "fragen": [
     {
      "frage": "Why do you check each of the four king moves one by one here?",
      "antworten": [
       "Only the king can get out of the check, and each king move allows White a different continuation.",
       "Black can also simply capture the knight on g5.",
       "A pawn move to f5 also blocks the check."
      ],
      "richtig": 0,
      "erklaerung": "Black has exactly four legal moves, all with the king. Step 3 looks for White's strongest reply to each one."
     }
