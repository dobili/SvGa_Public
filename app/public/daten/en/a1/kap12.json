 "uebungen": [
  {
   "id": "ueb:kandidatenzuege",
   "nummer": 83,
   "kapitel": 12,
   "titel": null,
   "abbildungen": [
    "12.5"
   ],
   "aufgabe": [
    {
     "art": "text",
     "text": "Die Stellung gleicht dem Beispiel aus ",
     "stil": "normal"
    },
    {
     "art": "verweis",
     "text": "Abb. 12.1",
     "abbildung": "12.1"
    },
    {
     "art": "text",
     "text": " bis auf eine Figur: Die schwarze Dame steht auf d8 statt auf c7. Gehe für den Kandidaten ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "1. Lxh7+"
    },
    {
     "art": "text",
     "text": " die vier Schritte der Denkroutine durch. Spielst du ihn?",
     "stil": "normal"
    }
   ],
   "loesung": [
    {
     "art": "text",
     "text": "Nein. Schritt 3 verlangt die stärkste Antwort, und dazu gehören nicht nur Königszüge. Nach ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "1. Lxh7+? Kxh7 2. Sg5+"
    },
    {
     "art": "text",
     "text": " schlägt die Dame den Springer: ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "2... Dxg5!"
    },
    {
     "art": "text",
     "text": ". Von d8 aus bewacht sie das Feld g5, und keine weiße Figur deckt den Springer. Weiß hat dann zwei Figuren für einen Bauern gegeben. Besser ist ein ruhiger Zug wie ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "1. Dc2"
    },
    {
     "art": "text",
     "text": ". Merke dir: Prüfe bei der stärksten Antwort zunächst die Schläge des Gegners, denn eine einzige Figur auf einem anderen Feld macht aus einem Gewinnopfer einen Fehler.",
     "stil": "normal"
    }
   ],
   "quelle": {
    "datei": "kap12_training.tex",
    "zeile": 1200
   },
   "erklaerung": {
    "loesung": "1. Qc2",
    "akzeptiert": [],
    "motiv": "Stärkste Antwort prüfen",
    "text": "Nach 1. Lxh7+? Kxh7 2. Sg5+ schlägt die Dame von d8 aus mit 2... Dxg5!, und Weiß hat zwei Figuren für einen Bauern gegeben. Prüfe bei der stärksten Antwort zuerst die Schlagzüge des Gegners; besser ist ein ruhiger Zug wie 1. Dc2."
   }
  },
  {
   "id": "ueb:zeitnot-prinzipien",
   "nummer": 84,
   "kapitel": 12,
   "titel": null,
   "abbildungen": [
    "12.6"
   ],
   "aufgabe": [
    {
     "art": "text",
     "text": "Du hast noch drei Minuten für zwölf Züge. Der Bauer d5 sieht ungedeckt aus, da zwischen ihm und dem Turm d8 der schwarze Läufer d6 steht. Schlägst du ihn mit dem Turm? Welche der drei Fragen des Sicherheitsblicks entscheidet?",
     "stil": "normal"
    }
   ],
   "loesung": [
    {
     "art": "text",
     "text": "Nein. Es entscheidet die dritte Frage: Erlaube ich ihm ein Schach? Nach ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "1. Txd5??"
    },
    {
     "art": "text",
     "text": " zieht der Läufer mit Schach ab und gibt dabei die d-Linie frei: ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "1... Lxh2+! 2. Kxh2 Txd5"
    },
    {
     "art": "text",
     "text": ". Schwarz hat die Qualität gewonnen und dafür nur den Bauern d5 gegeben. Das ist der Abzugsangriff aus Kapitel 7 (Motiv 4). Die Prüfung kostet wenige Sekunden, denn du suchst bloß die Schachs des Gegners, und hier gibt es genau eines. Richtig ist ein Zug wie ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "1. g3"
    },
    {
     "art": "text",
     "text": ", der die Diagonale nach h2 schließt. Erst dann droht ",
     "stil": "normal"
    },
    {
     "art": "zug",
     "text": "Txd5"
    },
    {
     "art": "text",
     "text": " wirklich. Merke dir: Suche auch in Zeitnot vor jedem Schlag die Schachs des Gegners.",
     "stil": "normal"
    }
   ],
   "quelle": {
    "datei": "kap12_training.tex",
    "zeile": 1212
   },
   "erklaerung": {
    "loesung": "1. g3",
    "akzeptiert": [],
    "motiv": "Sicherheitsblick in Zeitnot",
    "text": "Nach 1. Txd5?? zieht der Läufer mit Schach ab: 1... Lxh2+! 2. Kxh2 Txd5, und Schwarz gewinnt die Qualität. Die Frage nach den Schachs des Gegners entscheidet; 1. g3 schließt die Diagonale und droht erst dann Txd5."
   }
  },
  {
   "id": "ueb:fehlerprotokoll",
   "nummer": 85,
   "kapitel": 12,
   "titel": null,
   "abbildungen": [],
   "aufgabe": [
    {
     "art": "text",
     "text": "Nimm eine eigene Partie und erstelle ein Fehlerprotokoll. Benenne genau einen taktischen und einen strategischen Fehler. Ordne beiden eine Fehlerart aus Tabelle 12.2 zu, formuliere je einen besseren Kandidatenzug oder Plan und überprüfe erst im Anschluss mit einer Engine, ob deine Analyse die Hauptidee getroffen hat. Falls du noch keine eigene Partie hast, nutze eine Partie aus Kapitel 11 und erstelle das Protokoll zu einer dort beschriebenen Schlüsselstelle.",
     "stil": "normal"
    }
   ],
   "loesung": [
    {
     "art": "text",
     "text": "Ein gutes Fehlerprotokoll nennt einen konkreten Zug statt eine vage Phase wie „meine Eröffnung war schlecht“. Beispiel: „Ich übersah nach meinem Zug die Springergabel auf d4 (Kapitel 7)“ und „ich tauschte meine aktive Figur gegen eine passive (Kapitel 6)“. Die Fehlerarten dazu heißen „Taktik übersehen“ und „Plan oder Figurenaktivität“. Die Beispielzeile in Tabelle 12.1 zeigt, wie du den ersten Fehler einträgst. Die Engine ist erst der Kontrollpartner, nicht der Ersatz für die eigene Analyse. Merke dir: Ein Fehler, den du in einem Satz benennen kannst, lässt sich gezielt trainieren.",
     "stil": "normal"
    }
   ],
   "quelle": {
    "datei": "kap12_training.tex",
    "zeile": 1224
   },
   "erklaerung": {
    "loesung": null,
    "akzeptiert": [],
    "motiv": "Fehlerprotokoll",
    "text": "Ein gutes Protokoll nennt einen konkreten Zug und ordnet ihn einer Fehlerart zu, etwa übersehene Taktik oder schwacher Plan. Erst danach prüft die Engine, ob die eigene Analyse die Hauptidee getroffen hat."
   }
  },
  {
   "id": "ueb:trainingsplan",
   "nummer": 86,
   "kapitel": 12,
   "titel": null,
   "abbildungen": [],
   "aufgabe": [
    {
     "art": "text",
     "text": "Entwirf einen konkreten Trainingsplan für sieben Tage. Lege für jeden Tag fest, welche Taktikaufgaben, welche Partieform und welches Kapitel du wiederholst. Sorge dafür, dass mindestens ein Tag die Analyse einer eigenen verlorenen Partie enthält.",
     "stil": "normal"
    }
   ],
   "loesung": [
    {
     "art": "text",
     "text": "Ein guter Plan ist konkret: etwa Montag Taktikaufgaben zu Gabeln plus eine Partie mit 10+0 (Partietag aus Tabelle 12.3), Dienstag die Philidor-Stellung aus Kapitel 9 im Analysebrett gegen den Computer verteidigen, Mittwoch eigene Partie analysieren, Donnerstag eine Meisterpartie zum Isolani nachspielen (Fischer, Kapitel 11), Freitag eine kurze Partie mit anschließender Fehlersuche spielen, Samstag zwei elementare Endspielstellungen wiederholen und Sonntag eine lange Partie (etwa 15+10) spielen, die Fehlerdatenbank ergänzen sowie die häufigste Fehlerart der Woche trainieren. Merke dir: Entscheidend ist die Mischung aus Spielen, Analyse und gezieltem Studium.",
     "stil": "normal"
    }
   ],
   "quelle": {
    "datei": "kap12_training.tex",
    "zeile": 1235
   },
   "erklaerung": {
    "loesung": null,
    "akzeptiert": [],
    "motiv": "Trainingsplan",
    "text": "Ein guter Plan mischt an sieben Tagen Taktik, Partien, Endspiele, Meisterpartien und die Analyse einer eigenen verlorenen Partie. Er nennt für jeden Tag konkrete Inhalte statt allgemeiner Vorsätze."
   }
  }
 ],
