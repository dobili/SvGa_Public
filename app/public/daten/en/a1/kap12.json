   "vorbereitet": {
    "status": "freigegeben",
    "fragen": [
     {
      "zug": "1. Bxh7+",
      "frage": "Why do you check 1. Bxh7+ before the quiet 1. Rc1?",
      "antworten": [
       "Quiet moves are not allowed in the thinking routine.",
       "Bxh7+ wins a pawn without any calculation.",
       "A check leaves your opponent the fewest replies, so you calculate it first."
      ],
      "richtig": 2,
      "erklaerung": "After Bxh7+, Black has only two moves. Forcing moves like this are quick to calculate to the end, so they come first."
     }
    ]
   }
