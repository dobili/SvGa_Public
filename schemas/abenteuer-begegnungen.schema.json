{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schach-von-grund-auf.com/schemas/abenteuer-begegnungen.schema.json",
  "title": "Begegnungen des Schach-Abenteuers",
  "description": "Eine Begegnung ist eine Partie, die die Geschichte auslöst (Ink: beginnePartie(kennung)); sie nennt Gegner, Farbe, Format, Startstellung und ob Karten erlaubt sind. Daraus baut das Spiel zur Laufzeit den Partieauftrag (app/src/abenteuer/schnittstelle/partie.ts) mit Deck, Zustand und gerechneter Stärke.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "begegnungen"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "begegnungen": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/begegnung" }
    }
  },
  "$defs": {
    "kennung": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-z][a-zA-Z0-9]*$"
    },
    "format": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art"],
          "properties": { "art": { "const": "partie" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "zuege", "mindestvorteil"],
          "properties": {
            "art": { "const": "stellungsduell" },
            "zuege": { "type": "integer", "minimum": 5, "maximum": 30 },
            "mindestvorteil": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        }
      ]
    },
    "startstellung": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art"],
          "properties": { "art": { "const": "grundstellung" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "fen"],
          "properties": {
            "art": { "const": "fen" },
            "fen": { "type": "string", "minLength": 10 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "nummer"],
          "properties": {
            "art": { "const": "abbildung" },
            "nummer": {
              "type": "string",
              "pattern": "^[0-9]{1,2}\\.[0-9]{1,3}$"
            }
          }
        }
      ]
    },
    "begegnung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kennung",
        "gegner",
        "farbe",
        "format",
        "startstellung",
        "kartenErlaubt"
      ],
      "properties": {
        "kennung": { "$ref": "#/$defs/kennung" },
        "gegner": { "$ref": "#/$defs/kennung" },
        "farbe": {
          "description": "Farbe des Lesers; „zufall“ wechselt",
          "enum": ["white", "black", "zufall"]
        },
        "format": { "$ref": "#/$defs/format" },
        "startstellung": { "$ref": "#/$defs/startstellung" },
        "kartenErlaubt": { "type": "boolean" },
        "variante": {
          "description": "Schachvariante eines Nebenschauplatzes (Akt 4, docs/spiel/10): blind = Blindschach, Figuren unsichtbar; schach960 = Zufallsschach, Grundreihe gemischt (V1); gehoer = Partie nach Gehör (Runde 6, Funkschach): der Gegnerzug erscheint erst als Ansage, dann auf dem Brett. Varianten zählen nie für Nadeln, Wertung oder die App",
          "enum": ["blind", "schach960", "gehoer"]
        },
        "startnummer": {
          "description": "Nur mit variante schach960: feste Startstellung (Zählung nach Scharnagl, 518 = Grundstellung); fehlt sie, wird jede Partie neu ausgelost",
          "type": "integer",
          "minimum": 0,
          "maximum": 959
        },
        "abgelenktAb": {
          "description": "Stärkewechsel mitten in der Partie (Akt 4, Halbfinale): ab diesem Halbzug macht der Gegner um den Faktor häufiger Fehler",
          "type": "object",
          "additionalProperties": false,
          "required": ["halbzug", "faktor"],
          "properties": {
            "halbzug": { "type": "integer", "minimum": 1, "maximum": 300 },
            "faktor": { "type": "number", "minimum": 1, "maximum": 3 }
          }
        },
        "kandidaten": {
          "description": "Partieform Kandidatenwahl (Runde 6, docs/spiel/15 Abschnitt 4): Der erste Zug des Gegners ist zufällig einer dieser Züge (SAN, englisch), einer davon ein Fehler",
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 2 }
        },
        "buchbruch": {
          "description": "Partieform Buch und Bruch (Runde 6, Z-1): Der Gegner folgt der Linie (SAN beider Seiten ab der Startstellung); weicht der Leser ab, spielt er auf dieser Stufe weiter",
          "type": "object",
          "additionalProperties": false,
          "required": ["linie", "stufe"],
          "properties": {
            "linie": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 2 }
            },
            "stufe": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        },
        "freieKarten": {
          "description": "Karten, die in dieser Begegnung ohne Besitz zusätzlich im Deck liegen, nicht verbraucht werden und nicht für Nadel und Wertung zählen (R29: Mentor-Zug im Halbfinale); Kennungen aus karten.json",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
        },
        "zeit": {
          "description": "Bedenkzeit (Schritt 13): „wahl“ lässt den Leser vor der Partie wählen (ohne Uhr, Schnellschach, Blitz); eine feste Uhr gehört zur Geschichte (Schaffner 3 + 2). Fehlend: ohne Uhr",
          "oneOf": [
            { "const": "wahl" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sekunden", "zuschlag"],
              "properties": {
                "sekunden": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 3600
                },
                "zuschlag": { "type": "integer", "minimum": 0, "maximum": 60 }
              }
            }
          ]
        },
        "zaehltFuerApp": {
          "description": "Fehlend: ja für Partien aus der Grundstellung (Entscheidung A2)",
          "type": "boolean"
        }
      }
    }
  }
}
