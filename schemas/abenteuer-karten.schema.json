{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schach-von-grund-auf.com/schemas/abenteuer-karten.schema.json",
  "title": "Hilfskarten des Schach-Abenteuers",
  "description": "Kartensorten (Typ Kartensorte in app/src/abenteuer/schnittstelle/karten.ts). Karten ändern Informationen, Züge oder die Startstellung, nie die Zugregeln. Stufe und Art bestimmen die Clubnadel: Gold ohne Karten, Silber mit höchstens zwei leichten, sonst Bronze.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "karten"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "karten": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/karte" }
    }
  },
  "$defs": {
    "textschluessel": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
    },
    "feld": {
      "description": "Feld der Figur, die der Gegner bei einer Vorgabe nicht bekommt (Schreibweise aus Sicht des Gegners: Weiß f2, Schwarz f7; das Spiel spiegelt je nach Farbe)",
      "type": "string",
      "pattern": "^[a-h][1-8]$"
    },
    "wirkung": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art"],
          "properties": {
            "art": {
              "enum": [
                "fingerzeig",
                "gefahrenradar",
                "zweiteChance",
                "mentorzug",
                "sanduhr"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "kandidaten"],
          "properties": {
            "art": { "const": "fluestern" },
            "kandidaten": { "type": "integer", "minimum": 2, "maximum": 3 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "feld"],
          "properties": {
            "art": { "const": "vorgabe" },
            "feld": { "$ref": "#/$defs/feld" }
          }
        },
        {
          "description": "Uhr ändern (docs/spiel/10, S1): Kühler Kopf (+ für den Leser), Grübelfalle (− für den Gegner); nur mit Uhr",
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "wer", "sekunden"],
          "properties": {
            "art": { "const": "zeit" },
            "wer": { "enum": ["leser", "gegner"] },
            "sekunden": { "type": "integer", "minimum": -600, "maximum": 600 }
          }
        },
        {
          "description": "Gefühlte Zeitnot des Gegners für so viele seiner Züge (Großes Maul, docs/spiel/10, S1; 08, Z6); die Uhr bleibt",
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "zuege"],
          "properties": {
            "art": { "const": "zeitnot" },
            "zuege": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        },
        {
          "description": "Ein Werkzeug des Buches auf die aktuelle Stellung (docs/spiel/11, K2, K6): Markierungen und Fazit wie im Buch; nur Werkzeuge, die allein die Stellung brauchen",
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "werkzeug"],
          "properties": {
            "art": { "const": "werkzeug" },
            "werkzeug": { "type": "string", "pattern": "^k[0-9]+-[a-z]+$" }
          }
        },
        {
          "description": "Was droht? (K1), Waage (K3), Remisangebot (K5), Schmeichelei (S7, vor der Partie: Gegner überheblich)",
          "type": "object",
          "additionalProperties": false,
          "required": ["art"],
          "properties": {
            "art": { "enum": ["drohung", "waage", "remis", "schmeichelei"] }
          }
        }
      ]
    },
    "karte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kennung",
        "name",
        "spruch",
        "bild",
        "stufe",
        "art",
        "wirkung",
        "zeitpunkt"
      ],
      "properties": {
        "kennung": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "name": { "$ref": "#/$defs/textschluessel" },
        "spruch": {
          "description": "Ambroses Satz auf der Karte (Textschlüssel)",
          "$ref": "#/$defs/textschluessel"
        },
        "bild": {
          "type": "string",
          "pattern": "^karten/[a-z0-9-]+\\.(webp|png)$"
        },
        "stufe": { "enum": ["leicht", "mittel", "stark"] },
        "art": {
          "description": "dauerhaft: einmal je Partie, bleibt im Besitz; verbrauch: verschwindet nach dem Spielen",
          "enum": ["dauerhaft", "verbrauch"]
        },
        "wirkung": { "$ref": "#/$defs/wirkung" },
        "kapitel": {
          "description": "Lernkarte (docs/spiel/11, Abschnitt 5): wer in der App alle Übungen dieses Buchkapitels löst, bekommt die Karte im Spiel geschenkt",
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "spruch_art": {
          "description": "Ein Spruch des Helden (docs/spiel/10, S1 bis S6): nur gegen Straßengegner, nie im Club oder Turnier; Texte spruch.<kennung>.1 bis .8",
          "type": "boolean"
        },
        "zeitpunkt": {
          "description": "Vorgaben vor Partiebeginn, die meisten während der Partie, die Sanduhr nachher (Regelwerk R25)",
          "enum": ["vorher", "waehrend", "nachher"]
        }
      }
    }
  }
}
