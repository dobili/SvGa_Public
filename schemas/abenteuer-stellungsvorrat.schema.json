{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schach-von-grund-auf.com/schemas/abenteuer-stellungsvorrat.schema.json",
  "title": "Stellungsvorrat des Schach-Abenteuers",
  "description": "Startstellungen der kurzen Partieformen aus Partien App-Bot gegen App-Bot (app/src/abenteuer/vorratspartien.messung.ts, Auswahl pipeline/abenteuer/stellungsvorrat.py), je Stärkeband und Format; der Leser übernimmt die Seite am Zug. Die App wählt passend zur Stärke des Gegners und ohne Wiederholung (app/src/abenteuer/regeln/vorrat.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baender"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "baender": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/band"
      }
    }
  },
  "$defs": {
    "eintrag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kennung", "fen", "zuege", "bewertung"],
      "properties": {
        "kennung": {
          "type": "string",
          "pattern": "^band[0-9]+\\.[a-zA-Z]+[0-9]+$"
        },
        "fen": {
          "type": "string",
          "minLength": 10
        },
        "zuege": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "bewertung": {
          "description": "Bewertung aus Sicht der Seite am Zug in Bauern (Stockfish, Tiefe 12)",
          "type": "number"
        },
        "herkunft": {
          "description": "Woher die Stellung stammt: Partie zweier App-Bots (mit Maia und Praxisbuch) oder Rückfall Stockfish mit Skill Level",
          "type": "object",
          "additionalProperties": false,
          "required": ["quelle", "halbzug"],
          "properties": {
            "quelle": {
              "enum": ["bots", "stockfish"]
            },
            "halbzug": {
              "description": "Halbzüge ab der Grundstellung bis zur Stellung",
              "type": "integer",
              "minimum": 0
            },
            "weiss": {
              "$ref": "#/$defs/seite"
            },
            "schwarz": {
              "$ref": "#/$defs/seite"
            },
            "skillLevel": {
              "description": "Nur beim Rückfall Stockfish",
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        }
      }
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kennung", "eloVon", "eloBis", "formate"],
      "properties": {
        "kennung": {
          "type": "string",
          "pattern": "^band[0-9]+$"
        },
        "eloVon": {
          "type": "number"
        },
        "eloBis": {
          "type": "number"
        },
        "formate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stellungsduell",
            "vorteil",
            "endspielSieg",
            "endspielRemis"
          ],
          "properties": {
            "stellungsduell": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/eintrag"
              }
            },
            "vorteil": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/eintrag"
              }
            },
            "endspielSieg": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/eintrag"
              }
            },
            "endspielRemis": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/eintrag"
              }
            }
          }
        }
      }
    },
    "seite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bot", "stil"],
      "properties": {
        "bot": {
          "description": "Kennung des Bots der App (engine/gegnerliste.ts)",
          "type": "string"
        },
        "stil": {
          "type": "string"
        }
      }
    }
  }
}
