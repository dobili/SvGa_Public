{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schach-von-grund-auf.com/schemas/index.schema.json",
  "title": "Datenverzeichnis",
  "description": "Verzeichnis aller Kapitel und Abbildungen einer Sprache und Auflage (index.json). Die App lädt es zuerst.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sprache",
    "auflage",
    "datenstand",
    "kapitel",
    "glossar",
    "nachschlagen"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sprache": {
      "enum": ["de", "en"]
    },
    "auflage": {
      "type": "integer",
      "minimum": 1
    },
    "datenstand": {
      "description": "Datum des Datenlaufs",
      "type": "string",
      "format": "date"
    },
    "kapitel": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kapitel", "titel", "datei", "abbildungen"],
        "properties": {
          "kapitel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "titel": {
            "type": "string"
          },
          "datei": {
            "type": "string",
            "pattern": "^kap[0-9]{2}\\.json$"
          },
          "abbildungen": {
            "description": "Nummern in Buchreihenfolge",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warum": {
            "description": "Zahl der Warum-Fragen je Abbildung, nur Abbildungen mit Fragen (für den Lernpfad, 6.11.2026). Freiwillig, damit ältere Daten gültig bleiben.",
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "glossar": {
      "description": "Datei des Glossars",
      "const": "glossar.json"
    },
    "nachschlagen": {
      "description": "Datei mit Denkroutine und Gesamt-Checkliste (AP 5)",
      "const": "nachschlagen.json"
    }
  }
}
